# ─── Block sensitive files ────────────────────────────────────────────────────
<FilesMatch "^\.env(\..*)?$">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Pass real files and directories through unchanged
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # API endpoints keep .php (Paystack webhooks, check-payment, etc.)
    RewriteRule ^api/ - [L]

    # Clean URLs for admin: /admin/bookings → /admin/bookings.php
    RewriteCond %{DOCUMENT_ROOT}/admin/$2.php -f
    RewriteRule ^(admin)/([^/.]+)/?$ $1/$2.php [L,QSA]

    # Clean URLs for frontend: /about → /about.php
    RewriteCond %{DOCUMENT_ROOT}/$1.php -f
    RewriteRule ^([^/.]+)/?$ $1.php [L,QSA]

    # Fallback: 404
    RewriteRule ^ 404.php [L]
</IfModule>
